#!/bin/sh
set -e

LOG_FORMAT="${LOG_FORMAT:-text}"
export LOG_CHANNEL="${LOG_CHANNEL:-stderr}"
export SCHEDULER_LOG_OUTPUT="${SCHEDULER_LOG_OUTPUT:-/proc/1/fd/2}"
export QUEUE_LOG_FLAGS=""
export SCHEDULER_LOG_FLAGS=""

case "$LOG_FORMAT" in
    text)
        unset LOG_STDERR_FORMATTER
        ;;
    json)
        export LOG_STDERR_FORMATTER='Monolog\Formatter\JsonFormatter'
        export QUEUE_LOG_FLAGS="--json"
        export SCHEDULER_LOG_FLAGS="--quiet"
        ;;
    *)
        printf 'Invalid LOG_FORMAT: %s. Expected text or json.\n' "$LOG_FORMAT" >&2
        exit 1
        ;;
esac

cp "/etc/nginx/logging/$LOG_FORMAT.conf" /tmp/nginx-logging.conf

php8.5 artisan migrate --force --no-interaction

exec "$@"
